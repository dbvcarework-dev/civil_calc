# ── CIVIL CALC APP - PRODUCTION ENVIRONMENT VARIABLES ──
# Copy this file to '.env' on the production workstation before running Docker Compose.
# Do NOT commit the final '.env' file with real production secrets to version control!

# ── PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=pass123
DB_NAME=first_db

# ── JWT Authentication Secret (Change this to a strong, secure random string!)
JWT_SECRET=057f8abf94ec684c9dda398a7f37ffa484deda6915a6793021ecc6209a79cd70

# ── CORS Settings (Required if the API is accessed directly from different domains)
# Comma-separated list of origins. Set to the workstation's Public IP or domain name.
CORS_ORIGIN=http://localhost,http://127.0.0.1
